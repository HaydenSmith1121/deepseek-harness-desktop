{
  "name": "deepseek-harness-studio",
  "productName": "DeepSeek Harness",
  "version": "1.1.0",
  "description": "DeepSeek 桌面工作台：智能体对话（工具调用 / 流式输出 / 会话分组与归档）+ 多模型服务商（任意 OpenAI 兼容接口）+ 可安装插件 + 深色 / 浅色双主题",
  "main": "src/main/main.js",
  "author": "HaydenSmith1121",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaydenSmith1121/deepseek-harness-studio.git"
  },
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "screenshot": "electron . --screenshot",
    "screenshot:plugins": "electron . --screenshot-plugins",
    "test": "node tests/run.js",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "marked": "^12.0.0"
  },
  "build": {
    "appId": "top.heixinyun.deepseek-harness",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DeepSeek-Harness-Setup-${version}.exe"
    }
  }
}
